# SGAA Environment Configuration
# Copy this file to .env and fill in your values

# API Configuration
# User provides their own Anthropic API key at runtime
ANTHROPIC_API_KEY=user_provided_at_runtime

# Flask/FastAPI Secret Key (generate with: python -c "import secrets; print(secrets.token_hex(32))")
FLASK_SECRET_KEY=your_secret_key_here

# Application Settings
MAX_STRATEGY_DOCS=5
MAX_GOAL_DOCS=15
ANALYSIS_TIMEOUT_SECONDS=120

# Session Recovery
SESSION_PERSISTENCE_PATH=./backend/session
ENABLE_AUTO_RECOVERY=true

# Mock Mode (set to false for production with real API)
USE_MOCK=true

# Deployment
FLASK_ENV=development
FLASK_DEBUG=1
FRONTEND_URL=http://localhost:3000
