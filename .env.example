# SGAA Environment Configuration
# Copy this file to .env and adjust as needed:  cp .env.example .env
#
# Every value below has a working default, so the app runs with no .env at all.

# ---------------------------------------------------------------------------
# Analysis mode
# ---------------------------------------------------------------------------
# USE_MOCK controls behaviour when NO API key is supplied in the browser.
#   true  - use the built-in heuristic analyzer (free, offline, no API calls)
#   false - require an API key and reject requests that arrive without one
# An API key entered in the app's UI always takes precedence over this setting.
USE_MOCK=true

# The Anthropic API key is entered by each user in the app at runtime and is
# never persisted server-side. Set this only if you want a server-wide default.
# ANTHROPIC_API_KEY=sk-ant-...

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
# Origins allowed to call the API. The backend defaults to the Vite dev server
# ports (http://localhost:3000 and http://localhost:5173); set this when
# serving the frontend from a different host.
# FRONTEND_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Limits (enforced in code; listed here for reference)
# ---------------------------------------------------------------------------
# Strategy documents per analysis    : 5   (StrategySynthesizer.MAX_DOCUMENTS)
# Goal documents per analysis        : 500 (AlignmentAnalyzer.MAX_GOAL_DOCUMENTS)
# Parallel analysis workers          : 5   (analyze_batch max_workers)
