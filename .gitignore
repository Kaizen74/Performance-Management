# Python
# NOTE: packaging dirs are anchored with a leading slash so they only match at
# the repo root. Unanchored ("lib/") they match at any depth and silently
# exclude real source directories such as frontend/src/lib/.
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
/build/
/develop-eggs/
/dist/
/downloads/
/eggs/
/.eggs/
/lib/
/lib64/
/parts/
/sdist/
/var/
/wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
ENV/
env/
.venv/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# Environment files
.env
.env.local

# OS
.DS_Store
Thumbs.db

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build outputs
frontend/dist/
frontend/build/

# Test
.pytest_cache/
.coverage
htmlcov/
.tox/

# Session data
backend/session/*.json
!backend/session/.gitkeep
